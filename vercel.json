{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "crons": [
        {
            "path": "/api/connectwise/sync/daily",
            "schedule": "*/15 * * * *"
        },
        {
            "path": "/api/connectwise/sync/sla-check",
            "schedule": "*/5 * * * *"
        },
        {
            "path": "/api/connectwise/sync/pending-closure",
            "schedule": "0 * * * *"
        },
        {
            "path": "/api/connectwise/sync/boards",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/connectwise/sync/departments",
            "schedule": "0 6 * * *"
        },
        {
            "path": "/api/connectwise/sync/locations",
            "schedule": "0 6 * * *"
        }
    ],
    "functions": {
        "src/app/api/connectwise/sync/**/route.ts": {
            "maxDuration": 300
        }
    }
}
